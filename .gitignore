# Ansible-rendered artifacts (secrets, node addresses, kubeconfig) — resolved values, never committed.
ansible/.generated/
.ansible/

# Tofu state can hold minted credentials in plaintext even when marked `sensitive`.
# .terraform.lock.hcl is NOT here — that's the provider version lockfile, meant to be committed.
tofu/**/.terraform/
# Wider than just the default filename — also catches `tofu state pull > x.tfstate` and
# `-state=foo.tfstate` snapshots, not only terraform.tfstate itself.
tofu/**/*.tfstate*
# OpenTofu dumps provider state into this on a crash — can carry the same secrets state does.
tofu/**/crash.log

# mdbook build output
docs/book/

# Local configs
.claude
.tmp

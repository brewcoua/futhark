# See tofu/bunny/refs.env for the format. References only, never values.

# The one base domain and the two subdomain labels this module needs: the peer domain
# (settings.tf) and the internal zone (dns.tf). config/sops/cluster.sops.yaml is the single source —
# Flux substitutes the same keys into manifests. See docs/src/conventions/domains.md.
TF_VAR_domain=config/sops/cluster.sops.yaml#["stringData"]["DOMAIN"]
TF_VAR_sub_internal=config/sops/cluster.sops.yaml#["stringData"]["SUB_INTERNAL"]
TF_VAR_sub_nodes=config/sops/cluster.sops.yaml#["stringData"]["SUB_NODES"]

# The mesh address the internal wildcard resolves to (dns.tf). The `nodes` map in the operator
# store is the canonical record: roles/netbird writes each node's mesh_ip back into it after a mesh
# join. The hostname is the ingress node's, the same one both Traefik HelmReleases pin to with
# nodeSelector and tofu/bunny/refs.env names. Moving ingress means changing it here too.
TF_VAR_mesh_ip=config/sops/ops.sops.yaml#["nodes"]["ogma"]["mesh_ip"]

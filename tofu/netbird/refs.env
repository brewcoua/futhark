# See tofu/bunny/refs.env for the format. References only, never values.

# The internal wildcard's base domain, served by traefik-internal. Flux owns it, as the Secret
# it substitutes into manifests as ${INT_DOMAIN}; tofu/bunny reads the same key. This module
# needs it as the NetBird DNS zone that resolves *.INT_DOMAIN for peers.
TF_VAR_int_domain=infra/substitutions/app/int-domain.sops.yaml#["stringData"]["INT_DOMAIN"]

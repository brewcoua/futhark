# Node addresses this module needs, pulled at plan/apply time by .taskfiles/tofu/Taskfile.yaml.
#
#   <tofu variable>=<node>:<key in ansible/nodes/<node>/host.sops.yml>
#
# References only, never values — that is why this file is committed in the clear while the
# thing it points at is encrypted. ansible/nodes/<node>/host.sops.yml is the canonical record
# for node addresses (roles/tailscale writes node_mesh_ip back into it after each tailnet
# join), so nothing here keeps a second copy that could drift.
TF_VAR_kenaz_public_ip=kenaz:node_ip

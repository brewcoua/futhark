# Values this module needs that another plane already owns, pulled at plan/apply time by
# .just/tofu.just:
#
#   <variable>=<repo-relative .sops file>#<sops --extract expression>
#
# References only, never values — that is why this file is committed in the clear while every
# file it names is encrypted. Nothing here keeps a second copy that could drift.

# ansible/nodes/<node>/host.sops.yml is the canonical record for node addresses: roles/tailscale
# writes node_mesh_ip back into it after each tailnet join.
TF_VAR_kenaz_public_ip=ansible/nodes/kenaz/host.sops.yml#["node_ip"]

# The tailnet MagicDNS suffix, target of the internal wildcard CNAME in dns.tf. Ansible owns it —
# roles/tailscale needs it on every node, which tofu/tailscale then reads the same way.
TF_VAR_tailnet_domain=ansible/inventory/group_vars/all/secrets.sops.yml#["tailnet_domain"]

# The internal wildcard's base domain (an apex domain unrelated to config/domain/domain.env's
# DOMAIN). Flux owns it, as the Secret it substitutes into manifests as ${INT_DOMAIN}.
TF_VAR_int_domain=infra/substitutions/app/int-domain.sops.yaml#["stringData"]["INT_DOMAIN"]

# Values this module needs that another plane already owns, pulled at plan/apply time by
# .just/tofu.just:
#
#   <variable>=<repo-relative .sops file>#<sops --extract expression>
#
# References only, never values — that is why this file is committed in the clear while every
# file it names is encrypted. Nothing here keeps a second copy that could drift.

# The `nodes` map in the operator store is the canonical record for node addresses: roles/netbird
# writes each node's mesh_ip back into it after a mesh join. The hostname below is the edge node's:
# the same one that sets public_ingress in ansible/nodes/<host>/host.yml and that both Traefik
# HelmReleases pin to. Moving public ingress means changing it here too.
TF_VAR_edge_public_ip=config/sops/ops.sops.yaml#["nodes"]["ogma"]["ip"]

# brokkr's, for the git and ci records. Named explicitly rather than derived: this host is not the
# edge node and never becomes it, so moving public ingress does not move these.
TF_VAR_brokkr_public_ip=config/sops/ops.sops.yaml#["nodes"]["brokkr"]["ip"]

# The one base domain, from the one place it is written down. See
# docs/src/conventions/domains.md.
TF_VAR_domain=config/sops/cluster.sops.yaml#["stringData"]["DOMAIN"]

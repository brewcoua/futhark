# See tofu/bunny/refs.env for the format. References only, never values.

# The internal wildcard's base domain, used by clients.tf for the internal redirect URIs. Flux
# owns it, as the Secret it substitutes into manifests as ${INT_DOMAIN}.
TF_VAR_int_domain=infra/substitutions/app/int-domain.sops.yaml#["stringData"]["INT_DOMAIN"]

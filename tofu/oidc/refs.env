# See tofu/bunny/refs.env for the format. References only, never values.

# The base domain and the internal subdomain label, for clients.tf's redirect URIs.
# config/sops/cluster.sops.yaml is the single source — Flux substitutes the same keys into manifests.
TF_VAR_domain=config/sops/cluster.sops.yaml#["stringData"]["DOMAIN"]
TF_VAR_sub_internal=config/sops/cluster.sops.yaml#["stringData"]["SUB_INTERNAL"]

# Template — see tofu/netbird/secrets.sops.env.example for the procedure and for why the
# pass:// lines below carry no braces.
POCKETID_BASE_URL=https://auth.example.com
POCKETID_API_TOKEN=pass://futharkd/pocketid/api token

# The `tofu-writer` machine identity, deliberately not the read-only one the cluster is seeded
# with in config/secrets.sops.yaml. Only this module may write /nodes/kenaz/actual.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=pass://futharkd/infisical-tofu-writer/client id
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=pass://futharkd/infisical-tofu-writer/client secret

TF_VAR_infisical_project_id=00000000-0000-0000-0000-000000000000

# TF_VAR_int_domain is deliberately absent: Flux owns the internal base domain, so this module
# reads it via refs.env. Naming it here would override the ref and reintroduce the second copy.

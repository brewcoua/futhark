# See tofu/bunny/refs.env for the format. References only, never values.

# The tailnet MagicDNS suffix. Ansible owns it — roles/tailscale needs it on every node — and
# tofu/bunny reads the same key for the internal wildcard CNAME's target.
TAILSCALE_TAILNET=ansible/inventory/group_vars/all/secrets.sops.yml#["tailnet_domain"]

# Values this module needs that another plane already owns, pulled at plan/apply time by
# .just/tofu.just:
#
#   <variable>=<repo-relative .sops file>#<sops --extract expression>
#
# References only, never values — that is why this file is committed in the clear while every
# file it names is encrypted. Nothing here keeps a second copy that could drift.

# The cluster store is the canonical record for both: Flux substitutes the bucket and region into
# K8up's operator environment when it renders the HelmRelease, so that file has to hold them.
# This module provisions what they name rather than naming it too.
TF_VAR_backups_bucket=config/sops/cluster.sops.yaml#["stringData"]["B2_BUCKET"]
TF_VAR_region=config/sops/cluster.sops.yaml#["stringData"]["B2_REGION"]

# brokkr's bucket comes from the operator store instead: it is read by Ansible, which builds the
# restic repository URL from it, and by nothing in the cluster. The region above is shared, because a
# B2 region is a fact of the account and both buckets are in it.
TF_VAR_brokkr_bucket=config/sops/ops.sops.yaml#["brokkr"]["B2_BUCKET"]

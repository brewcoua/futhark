# Template — see tofu/netbird/secrets.sops.env.example for the procedure and for why the
# pass:// lines below carry no braces.
#
# Anything named here WINS over refs.env, because `sops exec-env` runs after the refs are
# exported. A value present in both places is not a harmless duplicate: it silently disables the
# ref. The bucket name and region belong to refs.env — do not add them here.

# The provider's credential, on B2's native API. An application key, not the account's master key:
# it needs writeBuckets and writeKeys, both of which an application key can hold, and B2 refuses
# the master key on the S3 API that this module's own backend speaks.
#
# A key can only mint a key whose capabilities are a subset of its own, so this one must also
# carry everything keys.tf grants Velero.
B2_APPLICATION_KEY_ID=pass://futharkd/backblaze-tofu/key id
B2_APPLICATION_KEY=pass://futharkd/backblaze-tofu/application key

# The backend's credential, on B2's S3 API — a separate application key restricted to the state
# bucket, so the credential that can rewrite state cannot also create buckets or mint keys.
# AWS_* rather than B2_*: the s3 backend is the AWS one, pointed at another endpoint.
AWS_ACCESS_KEY_ID=pass://futharkd/backblaze-tofu-state/key id
AWS_SECRET_ACCESS_KEY=pass://futharkd/backblaze-tofu-state/application key

# 32 random bytes, base64. The state object is written under SSE-C with this key, because it holds
# the Velero key this module mints in plaintext — see backend.tf. Losing it loses the state, which
# is recoverable by re-import; it is in Proton Pass so that it is not only on one machine.
AWS_SSE_CUSTOMER_KEY=pass://futharkd/backblaze-tofu-state/sse-c key

# Identifying, not secret, and nothing else in the repo owns it — the cluster never reads this
# bucket, only tofu does. Created by hand at bootstrap: a module cannot create the bucket its own
# state lives in. Passed to `tofu init` as -backend-config, never written into a .tf file.
TF_BACKEND_BUCKET=example-tofu-state

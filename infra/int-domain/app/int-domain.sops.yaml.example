---
# Template. Copy to int-domain.sops.yaml, fill in, encrypt:
#
#   cp int-domain.sops.yaml.example int-domain.sops.yaml
#   $EDITOR int-domain.sops.yaml
#   sops -e -i int-domain.sops.yaml
#
# The internal wildcard's base domain, consumed as ${INT_DOMAIN} via postBuild.substituteFrom
# in every consumer's ks.yaml (infra/traefik-internal, infra/monitoring, nodes/kenaz.k0s/actual/ks.yaml).
#
# A Secret rather than a ConfigMap, same reasoning as infra/edge-ips/app/edge-ips.sops.yaml:
# substituteFrom accepts either, and SOPS encrypting a ConfigMap's data would be conspicuous
# mislabelling of something that is, in fact, hidden. DOMAIN (the edge domain) stays cleartext
# in config/domain/domain.env — only the internal domain moved here.
apiVersion: v1
kind: Secret
metadata:
  name: int-domain
  namespace: flux-system
type: Opaque
stringData:
  INT_DOMAIN: example.eu

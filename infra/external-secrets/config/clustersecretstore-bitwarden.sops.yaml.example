---
# yaml-language-server: $schema=https://raw.githubusercontent.com/external-secrets/external-secrets/main/deploy/crds/bundle.yaml
#
# Template. Copy to clustersecretstore-bitwarden.sops.yaml, fill in the two UUIDs, encrypt:
#
#   cp clustersecretstore-bitwarden.sops.yaml.example clustersecretstore-bitwarden.sops.yaml
#   $EDITOR clustersecretstore-bitwarden.sops.yaml
#   sops -e -i clustersecretstore-bitwarden.sops.yaml
#
# Bitwarden Secrets Manager — the crown-jewel tier. Infisical holds per-app operational secrets;
# this holds anything that could bootstrap or re-key the system, so its reach is deliberately
# nil until something earns an entry in `conditions` below.
#
# SOPS-encrypted because organizationID and projectID are identifying values: not credentials,
# but they tie this public repo to a Bitwarden tenant. SOPS encrypts values and leaves keys
# alone, so `kustomize build` still parses this file fine — only Flux needs the age key.
#
# EU endpoints. The .com defaults are a different data region and will 404 against an EU
# organisation.
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: bitwarden
spec:
  # Empty on purpose. A ClusterSecretStore with no satisfiable condition is unusable from every
  # namespace, which is the correct default for this tier — add a namespace here only when it
  # genuinely needs a crown-jewel secret, and say why in the same commit.
  conditions: []
  provider:
    bitwardensecretsmanager:
      apiURL: https://api.bitwarden.eu
      identityURL: https://identity.bitwarden.eu
      bitwardenServerSDKURL: https://bitwarden-sdk-server.external-secrets.svc.cluster.local:9998
      # Tracks the cert-manager-issued CA rather than pinning a base64 blob that goes stale at
      # the first renewal.
      caProvider:
        type: Secret
        name: bitwarden-tls-certs
        namespace: external-secrets
        key: ca.crt
      organizationID: REPLACE_WITH_ORG_UUID
      projectID: REPLACE_WITH_PROJECT_UUID
      auth:
        secretRef:
          credentials:
            name: bitwarden-access-token
            namespace: external-secrets
            key: token

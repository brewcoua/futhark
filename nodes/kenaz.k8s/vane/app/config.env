# Bifrost is the only model backend, and every provider behind it is its concern rather than this
# app's. Reached by Service rather than by its ingress host, which is why bifrost's policy overlay
# opens a hole for this namespace.
#
# Vane has no notion of a gateway: this is its generic OpenAI provider pointed somewhere else. It
# reads OPENAI_BASE_URL and the matching OPENAI_API_KEY into data/config.json on the boot that
# creates that file and never reads them again, so changing either one here needs the provider
# edited in Settings as well.
#
# A non-default base URL also empties Vane's built-in model list, by design: it ships the OpenAI
# catalogue only when the URL is OpenAI's. Add the models in Settings, spelled the way bifrost
# resolves them, ollama/deepseek-v4-flash:cloud and ollama/deepseek-v4-pro:cloud.
OPENAI_BASE_URL=http://bifrost.bifrost.svc.cluster.local/v1

# The cluster's own instance, the same one Open WebUI searches with. Vane reads it as JSON, which
# nodes/kenaz.k8s/searxng/app/settings.yml enables, and it is also why that file now overrides the
# wolframalpha engine.
SEARXNG_API_URL=http://searxng.searxng.svc.cluster.local

# DATA_DIR is deliberately unset. It moves config.json and db.sqlite but not the upload store,
# which resolves against the working directory. Unset puts all three under /home/vane/data, which
# is the one path the PVC has to cover.

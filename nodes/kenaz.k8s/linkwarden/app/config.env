# NextAuth rejects a base URL without this suffix, so it is part of the value rather than a path
# the app appends.
NEXTAUTH_URL=https://links.${SUB_INTERNAL}.${DOMAIN}/api/v1/auth
# Page archives, previews and uploads. The image's default is `data` relative to its WORKDIR of
# /data, which is the application itself; spelled absolute here so the PVC mount and this value
# cannot drift apart.
STORAGE_FOLDER=/data/data
# The image runs as root and puts HOME at /root, which this pod's UID cannot write. Chromium and
# monolith both want a home to scribble in during an archive.
HOME=/tmp

# Login is Pocket ID and nothing else. OIDC_CLIENT_ID and OIDC_CLIENT_SECRET are deliberately
# absent: Pocket ID mints both, so they arrive through linkwarden-secrets. See tofu/oidc/clients.tf.
NEXT_PUBLIC_DISABLE_REGISTRATION=true
NEXT_PUBLIC_CREDENTIALS_ENABLED=false
NEXT_PUBLIC_OIDC_ENABLED=true
# Pocket ID's own public endpoint (infra/auth, edge-exposed). ${DOMAIN} rather than a
# `replacements` block because the domain sits mid-string, ahead of a path. See
# infra/substitutions/ks.yaml.
OIDC_WELLKNOWN_URL=https://auth.${DOMAIN}/.well-known/openid-configuration
OIDC_CUSTOM_NAME=Pocket ID

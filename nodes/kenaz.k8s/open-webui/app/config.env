# Most of Open WebUI's settings are ConfigVars: read from the database once seeded, with the
# environment ignored thereafter. False inverts that, so this file is what runs after every
# restart and the commit stays the record. The cost is that admin-UI edits apply to the running
# session only.
ENABLE_PERSISTENT_CONFIG=False
WEBUI_URL=https://chat.${SUB_INTERNAL}.${DOMAIN}
WEBUI_NAME=futhark
ENABLE_VERSION_UPDATE_CHECK=False
# The image defaults HOME to /root, which readOnlyRootFilesystem makes unwritable. Point it at
# the PVC so anything homedir-bound lands there instead of crashing the pod.
HOME=/app/backend/data
# Function requirements are pip-installed at runtime; with site-packages read-only pip falls
# back to a user install under HOME. site.py only puts the user site directory on sys.path when
# it already exists at interpreter startup, so the first install of a package is unimportable
# until a restart. PYTHONPATH is added regardless of whether the directory exists.
PYTHONPATH=/app/backend/data/.local/lib/python3.11/site-packages
# On import Open WebUI empties STATIC_DIR and re-copies /app/build/static into it, then mounts
# it at /static. Its default is inside the image, so on a read-only root every one of those
# copies fails: caught and logged, but fifteen ERROR lines per boot, which is what
# infra/glance/config/widget-log-errors.yml would then report forever. An emptyDir rather than
# the PVC because the directory is rebuilt from the image on every start, so it is derived
# rather than state, and backing it up would only preserve a stale copy.
STATIC_DIR=/app/static

# Bifrost is the only model backend, and every provider behind it is its concern rather than
# this app's. Reached by Service rather than by its ingress host, which is why bifrost's policy
# overlay opens a hole for this namespace. Bifrost's OpenAI-compatible surface is used rather
# than its Ollama one so that adding a non-Ollama provider there needs no change here.
#
# OPENAI_API_KEYS carries the virtual key bifrost issues this app, not a provider key: it is a
# credential, so it lives in Infisical. The Ollama Cloud key moved to /nodes/kenaz/bifrost.
ENABLE_OLLAMA_API=False
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URLS=http://bifrost.bifrost.svc.cluster.local/v1

# Login is Pocket ID and nothing else. OAUTH_CLIENT_ID and OAUTH_CLIENT_SECRET are deliberately
# absent: Pocket ID mints both, so they arrive through open-webui-secrets. See
# tofu/oidc/clients.tf.
ENABLE_LOGIN_FORM=False
ENABLE_SIGNUP=False
ENABLE_OAUTH_SIGNUP=True
OAUTH_PROVIDER_NAME=Pocket ID
# Pocket ID's own public endpoint (infra/auth, edge-exposed). ${DOMAIN} rather than a
# `replacements` block because the domain sits mid-string, ahead of a path. See
# infra/substitutions/ks.yaml. OPENID_REDIRECT_URI is left unset: its default,
# <WEBUI_URL>/oauth/oidc/callback, is the URL registered on the client.
OPENID_PROVIDER_URL=https://auth.${DOMAIN}/.well-known/openid-configuration
OAUTH_SCOPES=openid email profile groups
# The client sets pkce_enabled = true, so the challenge is not optional.
OAUTH_CODE_CHALLENGE_METHOD=S256
# Pocket ID puts the two fleet-wide groups from tofu/oidc/groups.tf in the `groups` claim;
# Open WebUI's default roles claim is `roles`, which Pocket ID never sends.
ENABLE_OAUTH_ROLE_MANAGEMENT=True
OAUTH_ROLES_CLAIM=groups
OAUTH_ALLOWED_ROLES=administrators,users
OAUTH_ADMIN_ROLES=administrators

# Web search against the SearXNG in the sibling namespace, reached by Service rather than by
# its ingress host, which is why searxng's policy overlay opens a hole for this namespace.
# <query> is a placeholder Open WebUI substitutes, not a Flux variable.
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng.searxng.svc.cluster.local/search?q=<query>
WEB_SEARCH_RESULT_COUNT=5
# Results go straight into the model's context instead of through the vector store. No RAG was
# asked for, and this keeps a search off the embedding path at query time.
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=True

# Bifrost is the only model backend, and every provider behind it is its concern rather than this
# app's. Reached by Service rather than by its ingress host, which is why bifrost's policy overlay
# opens a hole for this namespace.
#
# OPENAI_API_BASE keeps that name rather than gaining a KVASIR_ alias because it is the conventional
# spelling for an OpenAI-compatible endpoint, which is what bifrost serves. Nothing reads it out of
# the environment behind our back: the app passes both it and OPENAI_API_KEY, which arrives from
# Infisical, explicitly to every model and to the encoder.
OPENAI_API_BASE=http://bifrost.bifrost.svc.cluster.local/v1

# Everything after the routing prefix reaches bifrost exactly as written; kvasir checks that a
# prefix is there at all and nothing else. The leading openai/ is dspy's, for an OpenAI-compatible
# endpoint, and it is consumed before the request leaves; the rest is how bifrost resolves the
# ollama provider. Dated tags rather than the :cloud alias Vane
# uses, so the model behind each name does not move. The fast one simulates the research
# conversations and polishes; the strong one writes the outline and the article.
KVASIR_MODEL_FAST=openai/ollama/deepseek-v4-flash:0731
KVASIR_MODEL_STRONG=openai/ollama/deepseek-v4-pro:0813

# The cluster's own instance, the same one Open WebUI and Vane search with. Kvasir reads it as JSON,
# which nodes/kenaz.k8s/searxng/app/settings.yml already enables. An HTML-only instance fails as an
# empty result set rather than an error, which looks like a topic with no sources.
KVASIR_SEARXNG_URL=http://searxng.searxng.svc.cluster.local

# STORM ranks each section's sources by embedding them, so this is required rather than Co-STORM's
# concern, as it was while a local sentence-transformer did that job. The default,
# text-embedding-3-small, is a name bifrost cannot resolve. This one names munin, the ollama
# instance nodes/kenaz.k8s/munin runs for exactly this: openai/ is dspy's routing prefix and is
# consumed before the request leaves, munin/ is how bifrost picks the provider, and the rest is the
# model as ollama spells it.
KVASIR_EMBEDDING_MODEL=openai/munin/embeddinggemma:300m

# The tuning knobs are left at their defaults for the same reason kvasir ships no cost figures: they
# come from upstream's examples rather than from measurement, and KVASIR_MAX_CONV_TURN and
# KVASIR_MAX_PERSPECTIVE multiply into the number of conversations a run holds. Measure one run
# against this gateway before raising either.

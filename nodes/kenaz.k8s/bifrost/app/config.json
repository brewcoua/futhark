{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",

  "client": {
    "enable_logging": true,
    "enforce_auth_on_inference": true,
    "allowed_origins": ["https://llm.${SUB_INTERNAL}.${DOMAIN}"]
  },

  "providers": {
    "ollama": {
      "keys": [
        {
          "name": "ollama-cloud",
          "value": "env.OLLAMA_API_KEY",
          "models": ["*"],
          "weight": 1.0,
          "ollama_key_config": {
            "url": "https://ollama.com"
          }
        }
      ]
    },
    "cli-proxy": {
      "keys": [
        {
          "name": "cli-proxy",
          "value": "unauthenticated",
          "models": [
            "claude-3-5-haiku-20241022",
            "claude-3-7-sonnet-20250219",
            "claude-fable-5",
            "claude-haiku-4-5-20251001",
            "claude-opus-4-1-20250805",
            "claude-opus-4-20250514",
            "claude-opus-4-5-20251101",
            "claude-opus-4-6",
            "claude-opus-4-6-thinking",
            "claude-opus-4-7",
            "claude-opus-4-8",
            "claude-opus-5",
            "claude-sonnet-4-20250514",
            "claude-sonnet-4-5-20250929",
            "claude-sonnet-4-6",
            "claude-sonnet-5",
            "gemini-3-flash",
            "gemini-3-flash-agent",
            "gemini-3.1-flash-image",
            "gemini-3.1-flash-lite",
            "gemini-3.1-pro-low",
            "gemini-3.5-flash-extra-low",
            "gemini-3.5-flash-low",
            "gemini-3.6-flash-high",
            "gemini-3.7-flash-high",
            "gemini-pro-agent",
            "gpt-oss-120b-medium"
          ],
          "weight": 1.0
        }
      ],
      "custom_provider_config": {
        "base_provider_type": "anthropic"
      },
      "network_config": {
        "base_url": "http://cli-proxy-api.cli-proxy-api.svc.cluster.local:8317",
        "allow_private_network": true
      }
    }
  },

  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": false
    },
    "virtual_keys": [
      {
        "id": "vk-open-webui",
        "name": "open-webui",
        "value": "env.VK_OPEN_WEBUI",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "cli-proxy",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-cli",
        "name": "cli",
        "value": "env.VK_CLI",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "cli-proxy",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-vane",
        "name": "vane",
        "value": "env.VK_VANE",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-kvasir",
        "name": "kvasir",
        "value": "env.VK_KVASIR",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      }
    ]
  },

  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "logs_store": {
    "enabled": false
  },
  "source_of_truth": "config.json"
}

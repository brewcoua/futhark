# Every LDR setting is editable in its own Settings page until an environment variable names it.
# A variable does not set a default here: it forces the value and greys the field out. So this
# file holds only what the deployment genuinely owns, and everything a person should be able to
# change is deliberately absent.

# Forced because Docker networking says so, the same three the upstream compose forces.
LDR_WEB_HOST=0.0.0.0
LDR_WEB_PORT=5000
LDR_DATA_DIR=/data

# Bifrost is the only model backend, and every provider behind it is its concern rather than this
# app's. Reached by Service rather than by its ingress host, which is why bifrost's policy overlay
# opens a hole for this namespace. Forced because pointing this app somewhere else is a change to
# the deployment, not a preference.
#
# The matching LDR_LLM_OPENAI_ENDPOINT_API_KEY is the virtual key bifrost issues this app, not a
# provider key. It arrives from Infisical; tofu/bifrost writes it there and the identical value to
# /nodes/kenaz/bifrost. See docs/src/tofu/bifrost.md.
LDR_LLM_PROVIDER=openai_endpoint
LDR_LLM_OPENAI_ENDPOINT_URL=http://bifrost.bifrost.svc.cluster.local/v1

# The cluster's own instance, the same one Open WebUI searches with.
LDR_SEARCH_ENGINE_WEB_SEARXNG_DEFAULT_PARAMS_INSTANCE_URL=http://searxng.searxng.svc.cluster.local

# LDR_LLM_MODEL and LDR_SEARCH_TOOL are deliberately absent. Naming either here would pin it and
# remove the picker, and choosing per question is the point: ollama/deepseek-v4-flash:cloud for
# most reports, ollama/deepseek-v4-pro:cloud when one needs the reasoning more than the speed.
# Spell them provider-prefixed, as bifrost resolves them.
#
# LDR_APP_ALLOW_REGISTRATIONS=false belongs here too, once the first account exists. Adding it
# before that locks everyone out, including the operator.

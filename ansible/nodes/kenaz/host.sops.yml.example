---
# Template. At cold bootstrap, copy to host.sops.yml, put the real address in, and encrypt:
#
#   cp host.sops.yml.example host.sops.yml
#   $EDITOR host.sops.yml
#   sops -e -i host.sops.yml
#
# .sops.yaml seals ansible/** to the operator GPG key only — never the cluster age key.
# host_vars/kenaz/host.sops.yml symlinks here; playbooks fail closed until it exists.
node_ip: 203.0.113.10
# Leave this out at cold bootstrap — the tailscale role writes it after the node joins the
# tailnet, since the address is assigned at registration and can't be known in advance.
# node_mesh_ip: 100.64.0.1

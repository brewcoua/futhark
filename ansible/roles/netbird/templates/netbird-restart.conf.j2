# Generated by ansible/roles/netbird — do not edit by hand.
#
# Plain process death is systemd's job, not the watchdog's. The part worth overriding is the
# start limit: at its default, repeated fast crashes leave netbird.service permanently `failed`
# and systemd stops trying — on a node whose only route back in is the mesh this daemon carries.
# A drop-in overrides these three keys and nothing else in the packaged unit.
[Unit]
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=10s

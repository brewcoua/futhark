#!/bin/sh
# Generated by ansible/roles/netbird — do not edit by hand.
#
# Makes pod-originated traffic to a NetBird mesh peer's own address work: one route, one route
# fix and one SNAT rule per peer, all scoped to that peer's /32 so kube-router's pod-to-pod
# overlay is untouched. Why any of it is needed: docs/src/ansible/networking.md.
{% for host, ip in netbird_peer_ips.items() %}

# {{ host }}
# The table is this script's own ({{ mesh_route_table }}, mesh_route_table in
# group_vars/all/network.yml) and it holds exactly what is written here. NetBird keeps its
# routes in table 7120 and its own rules at priorities 105/110, so nothing below collides with
# it — but nothing below depends on its contents either, which is the point: the peer route is
# stated outright rather than borrowed from whatever the VPN happened to install.
ip route replace {{ ip }}/32 dev {{ mesh_interface }} table {{ mesh_route_table }}

# `ip rule add` does *not* dedupe — identical rules stack, and this unit re-runs on every
# play — so drain every copy first. Draining without matching on priority also clears rules
# left at a priority this script used previously.
#
# The priority (mesh_route_priority, in group_vars/all/network.yml) is load-bearing:
# kube-router installs its own `from <pod /24> lookup 77` rule,
# and anything numerically above it is silently shadowed, making this a no-op with no error.
# It's been 99, then 5209, and is priority 9 as of kube-router v2.10.0 (k0s v1.36.3) — check
# `ip rule` on the node after a kube-router bump rather than assuming a fixed gap holds.
while ip rule del to {{ ip }}/32 lookup {{ mesh_route_table }} 2>/dev/null; do :; done
ip rule add to {{ ip }}/32 lookup {{ mesh_route_table }} priority {{ mesh_route_priority }}

iptables -t nat -C POSTROUTING -s {{ k0s_pod_cidr }} -d {{ ip }}/32 -o {{ mesh_interface }} -j MASQUERADE 2>/dev/null \
  || iptables -t nat -A POSTROUTING -s {{ k0s_pod_cidr }} -d {{ ip }}/32 -o {{ mesh_interface }} -j MASQUERADE
{% endfor %}

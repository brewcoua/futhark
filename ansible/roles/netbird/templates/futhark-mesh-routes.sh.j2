#!/bin/sh
# Generated by ansible/roles/netbird — do not edit by hand.
#
# Makes pod-originated traffic to a NetBird mesh peer's own address work: one route, one routing
# rule and one SNAT rule per peer, all scoped to that peer's /32 so kube-router's pod-to-pod
# overlay is untouched. Why any of it is needed: docs/src/ansible/networking.md.
#
# The peer set is read from the running client rather than baked in at template time, because a
# peer re-registering onto a different mesh IP would otherwise strand these rules until someone
# ran Ansible — over the very mesh that is now half broken. futhark-mesh-watchdog re-runs this
# unit on every healthy probe, so drift corrects itself within one interval.
set -eu

TABLE={{ mesh_route_table }}
PRIORITY={{ mesh_route_priority }}
IFACE={{ mesh_interface }}
POD_CIDR={{ k0s_pod_cidr }}
CHAIN=FUTHARK-MESH

# Empty is a legitimate answer — a node alone in the mesh, or one whose daemon is down. It then
# means "tear down everything below and add nothing back", which is the correct state.
peers=$(netbird status --json 2>/dev/null | jq -r '.peers.details[]?.netbirdIp // empty' | sort -u)

# Everything this script owns is torn down and rebuilt from the current peer set, so a peer that
# has gone away leaves nothing behind. The table is ours alone ({{ mesh_route_table }},
# mesh_route_table in group_vars/all/network.yml) — NetBird keeps its routes in table 7120 and its
# rules at priorities 105/110, so nothing here collides with it, and nothing here depends on its
# contents either: the peer route is stated outright rather than borrowed from the VPN's.
#
# `ip rule add` does *not* dedupe — identical rules stack — so draining is a loop. Draining by
# table rather than by destination also clears rules left over at a priority this script used
# previously.
while ip rule del lookup "$TABLE" 2>/dev/null; do :; done
ip route flush table "$TABLE" 2>/dev/null || true

# A dedicated chain, so the SNAT rules can be flushed as a set. Rebuilding them in place in
# POSTROUTING would mean either leaking a rule per departed peer or grepping the live table.
iptables -t nat -N "$CHAIN" 2>/dev/null || true
iptables -t nat -F "$CHAIN"
iptables -t nat -C POSTROUTING -j "$CHAIN" 2>/dev/null ||
    iptables -t nat -A POSTROUTING -j "$CHAIN"

for peer in $peers; do
    ip route replace "$peer/32" dev "$IFACE" table "$TABLE"
    # The priority (mesh_route_priority, in group_vars/all/network.yml) is load-bearing:
    # kube-router installs its own `from <pod /24> lookup 77` rule, and anything numerically above
    # it is silently shadowed, making this a no-op with no error. It's been 99, then 5209, and is
    # priority 9 as of kube-router v2.10.0 (k0s v1.36.3) — check `ip rule` on the node after a
    # kube-router bump rather than assuming a fixed gap holds.
    ip rule add to "$peer/32" lookup "$TABLE" priority "$PRIORITY"
    iptables -t nat -A "$CHAIN" -s "$POD_CIDR" -d "$peer/32" -o "$IFACE" -j MASQUERADE
done

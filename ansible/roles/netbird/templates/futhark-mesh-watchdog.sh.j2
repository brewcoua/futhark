#!/bin/sh
# Generated by ansible/roles/netbird — do not edit by hand.
#
# Repairs this node's own NetBird connection without help from outside. It has to: a mesh node
# is reached over the mesh (ansible_host is <hostname>.{{ mesh_dns_domain }} — see
# inventory/group_vars/all/main.yml), so a broken client takes Ansible's own path down with it.
# Full write-up, including why no NetBird credential lives on the node: docs/src/ansible/mesh-watchdog.md.
set -u

STATE_FILE={{ netbird_watchdog_state_dir }}/mesh-watchdog.state
METRICS_FILE={{ netbird_watchdog_textfile_dir }}/futhark_mesh.prom
ENV_FILE=/etc/futhark/mesh-watchdog.env

# 0 ok, 1 degraded, 2 down, 3 stuck. Mirrors futhark_mesh_state in the alert rules —
# infra/monitoring/app/grafana/alerting/mesh.yaml.
STATE_OK=0
STATE_DEGRADED=1
STATE_DOWN=2
STATE_STUCK=3

consecutive_failures=0
last_action=none
last_action_ts=0
last_reboot_ts=0
repairs_restart_total=0
repairs_reup_total=0
repairs_reboot_total=0

# shellcheck source=/dev/null
[ -r "$STATE_FILE" ] && . "$STATE_FILE"
# PING_URL, empty or absent when this node has no healthchecks.io check yet.
PING_URL=""
# shellcheck source=/dev/null
[ -r "$ENV_FILE" ] && . "$ENV_FILE"

now=$(date +%s)

log() { echo "$1"; }

# healthchecks.io is reached over the public internet, never over the mesh — which is the whole
# point: it is the one channel that still works when the thing being watched is down. Failure to
# ping is never fatal, the local ladder does not depend on it.
ping_hc() {
    [ -n "$PING_URL" ] || return 0
    curl -fsS -m 10 --retry 2 -o /dev/null "${PING_URL}${1:-}" ||
        log "warn: healthchecks.io ping ${1:-/} failed"
}

# --- probe ---------------------------------------------------------------------------------

state=$STATE_DOWN
management=0
signal=0
peers_total=0
peers_connected=0
peers_handshaken=0

status_json=$(netbird status --json 2>/dev/null)
if [ -n "$status_json" ]; then
    # One jq pass, emitting shell-assignable lines. `.peers.details[]?` tolerates the field being
    # absent entirely, which it is on a peer that has never registered.
    eval "$(printf '%s' "$status_json" | jq -r '
        "management=" + (if .management.connected then "1" else "0" end),
        "signal=" + (if .signal.connected then "1" else "0" end),
        "peers_total=" + ((.peers.total // 0) | tostring),
        "peers_connected=" + ((.peers.connected // 0) | tostring),
        # A peer can report Connected while its tunnel is long dead, so freshness is read off the
        # handshake itself. The zero value NetBird emits (0001-01-01T00:00:00Z) parses to a large
        # negative epoch and so fails the window like any other stale peer.
        "peers_handshaken=" + ([.peers.details[]? |
            select(((.lastWireguardHandshake // "") | try fromdateiso8601 catch 0)
                > (now - {{ netbird_watchdog_handshake_max_age }}))] | length | tostring),
        "mesh_ip=" + ((.netbirdIp // "") | split("/") | first)
    ' 2>/dev/null)"
fi

if [ "$management" = 1 ] && [ "$signal" = 1 ] && [ -n "${mesh_ip:-}" ]; then
    # A lone node with no peers yet is healthy — there is nothing for it to hold a tunnel to.
    if [ "$peers_total" -eq 0 ] || [ "$peers_handshaken" -gt 0 ]; then
        state=$STATE_OK
    else
        state=$STATE_DEGRADED
    fi
fi

# --- ladder --------------------------------------------------------------------------------

action=none

if [ "$state" -eq "$STATE_OK" ]; then
    consecutive_failures=0
    # Idempotent and cheap, and it is what repairs route drift after a peer re-registers onto a
    # different mesh IP — the script derives the peer set at run time.
    systemctl start futhark-mesh-routes.service >/dev/null 2>&1 ||
        log "warn: futhark-mesh-routes failed"
else
    consecutive_failures=$((consecutive_failures + 1))
    log "netbird unhealthy (state=$state management=$management signal=$signal peers=$peers_handshaken/$peers_total) failures=$consecutive_failures"

    # One rung per cooldown window, so a repair gets several probes to take effect before the
    # next one escalates on top of it.
    if [ $((now - last_action_ts)) -lt {{ netbird_watchdog_action_cooldown }} ]; then
        log "within action cooldown, holding"
    elif [ "$consecutive_failures" -ge {{ netbird_watchdog_reboot_after }} ]; then
        if [ "$last_action" = reboot ] && [ $((now - last_reboot_ts)) -lt {{ netbird_watchdog_reboot_cooldown }} ]; then
            # Rebooted already and still broken: every automated lever is spent. Deliberately
            # terminal — the remaining causes (peer deleted from the account, corrupt local
            # config) need a credential this node does not have, by design.
            state=$STATE_STUCK
            log "error: ladder exhausted after a reboot — manual intervention required"
        else
            action=reboot
        fi
    elif [ "$consecutive_failures" -ge {{ netbird_watchdog_reup_after }} ]; then
        action=reup
    elif [ "$consecutive_failures" -ge {{ netbird_watchdog_restart_after }} ]; then
        action=restart
    fi
fi

case "$action" in
restart)
    log "restarting netbird"
    systemctl restart netbird.service || log "error: netbird restart failed"
    systemctl restart futhark-mesh-routes.service >/dev/null 2>&1 || true
    repairs_restart_total=$((repairs_restart_total + 1))
    ;;
reup)
    # Re-applies the stored configuration; no --setup-key, so this cannot re-enrol a peer the
    # account has forgotten. That case is the terminal one above.
    log "re-running netbird up"
    netbird down >/dev/null 2>&1 || true
    netbird up || log "error: netbird up failed"
    systemctl restart futhark-mesh-routes.service >/dev/null 2>&1 || true
    repairs_reup_total=$((repairs_reup_total + 1))
    ;;
reboot)
    uptime_s=$(cut -d. -f1 /proc/uptime)
    if [ "{{ netbird_watchdog_reboot | ternary('1', '0') }}" != 1 ]; then
        log "reboot rung reached but disabled for this node"
        action=none
        state=$STATE_STUCK
    elif [ "$uptime_s" -lt {{ netbird_watchdog_reboot_min_uptime }} ]; then
        # Never contribute to a boot loop: if the mesh is broken this soon after boot, another
        # reboot is not what fixes it.
        log "reboot rung reached but uptime ${uptime_s}s is below the floor"
        action=none
    elif [ $((now - last_reboot_ts)) -lt {{ netbird_watchdog_reboot_cooldown }} ]; then
        log "reboot rung reached but within the reboot cooldown"
        action=none
        state=$STATE_STUCK
    elif ! ip route show default | grep -q .; then
        # No upstream at all. NetBird is a symptom here, not the fault, and a reboot would take
        # the node down without addressing it.
        log "reboot rung reached but the node has no default route — not a netbird fault"
        action=none
    else
        log "rebooting: netbird unrecoverable after $consecutive_failures failed probes"
        last_reboot_ts=$now
        repairs_reboot_total=$((repairs_reboot_total + 1))
        # The counter resets so the ladder gets a fresh restart/re-up run after boot; if that
        # also fails it climbs back to this rung, the cooldown blocks it, and the node goes stuck.
        consecutive_failures=0
    fi
    ;;
esac

# --- persist -------------------------------------------------------------------------------

if [ "$action" != none ]; then
    last_action=$action
    last_action_ts=$now
fi

mkdir -p "$(dirname "$STATE_FILE")"
cat >"$STATE_FILE" <<EOF
consecutive_failures=$consecutive_failures
last_action=$last_action
last_action_ts=$last_action_ts
last_reboot_ts=$last_reboot_ts
repairs_restart_total=$repairs_restart_total
repairs_reup_total=$repairs_reup_total
repairs_reboot_total=$repairs_reboot_total
EOF

# node-exporter reads this directory whole and will happily scrape a half-written file, so the
# write is atomic.
if [ -d "$(dirname "$METRICS_FILE")" ]; then
    cat >"${METRICS_FILE}.tmp" <<EOF
# HELP futhark_mesh_state NetBird client health: 0 ok, 1 degraded, 2 down, 3 stuck.
# TYPE futhark_mesh_state gauge
futhark_mesh_state $state
# HELP futhark_mesh_management_connected NetBird management plane reachable.
# TYPE futhark_mesh_management_connected gauge
futhark_mesh_management_connected $management
# HELP futhark_mesh_signal_connected NetBird signal plane reachable.
# TYPE futhark_mesh_signal_connected gauge
futhark_mesh_signal_connected $signal
# HELP futhark_mesh_peers_total Peers this node knows about.
# TYPE futhark_mesh_peers_total gauge
futhark_mesh_peers_total $peers_total
# HELP futhark_mesh_peers_connected Peers NetBird reports as connected.
# TYPE futhark_mesh_peers_connected gauge
futhark_mesh_peers_connected $peers_connected
# HELP futhark_mesh_peers_handshaken Peers with a WireGuard handshake inside the freshness window.
# TYPE futhark_mesh_peers_handshaken gauge
futhark_mesh_peers_handshaken $peers_handshaken
# HELP futhark_mesh_consecutive_failures Consecutive unhealthy probes.
# TYPE futhark_mesh_consecutive_failures gauge
futhark_mesh_consecutive_failures $consecutive_failures
# HELP futhark_mesh_repairs_total Repair actions the watchdog has taken.
# TYPE futhark_mesh_repairs_total counter
futhark_mesh_repairs_total{action="restart"} $repairs_restart_total
futhark_mesh_repairs_total{action="reup"} $repairs_reup_total
futhark_mesh_repairs_total{action="reboot"} $repairs_reboot_total
# HELP futhark_mesh_last_run_timestamp_seconds When the watchdog last completed a probe.
# TYPE futhark_mesh_last_run_timestamp_seconds gauge
futhark_mesh_last_run_timestamp_seconds $now
EOF
    mv "${METRICS_FILE}.tmp" "$METRICS_FILE"
fi

# --- report --------------------------------------------------------------------------------

if [ "$state" -eq "$STATE_STUCK" ]; then
    ping_hc /fail
elif [ "$action" != none ]; then
    ping_hc /log
elif [ "$state" -eq "$STATE_OK" ]; then
    ping_hc
fi

# A reboot is the last thing that happens, after the state, the metrics and the ping are all on
# disk or delivered — otherwise the reason for the reboot dies with the boot.
[ "$action" = reboot ] && systemctl reboot

exit 0

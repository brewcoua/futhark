# The values the reconciler substitutes into every unit and config file it renders, so a public
# repository never spells an identifying one. This is the off-cluster equivalent of the
# `cluster-values` Secret that infra/substitutions publishes to Flux, and the keys are deliberately
# the same. See docs/src/conventions/domains.md.
#
# Managed by ansible/roles/quadlet_gitops — edits are overwritten. It sits in the config directory
# the reconciler rsyncs into, and survives that rsync's --delete for the same reason the secret env
# files do: the exclude is `*.env`, and Ansible owns every file matching it.
DOMAIN={{ dns.domain }}
SUB_INTERNAL={{ dns.sub.internal }}

# Woodpecker's server secrets. Written by ansible/roles/forge — see forgejo.env.j2.
#
# The forge pair is Forgejo's, not Pocket ID's: Woodpecker authenticates its users against the forge
# it serves. It is created once in Forgejo's own OAuth application list and filed into Proton Pass.
# Not a credential, but a local username is an identifying value and this repository is public, so
# it cannot be an Environment= line in the unit. Same reason tofu/netbird leaves
# authorized_groups unset.
WOODPECKER_ADMIN={{ secrets.brokkr.FORGEJO_ADMIN_USER }}
WOODPECKER_FORGEJO_CLIENT={{ secrets.brokkr.WOODPECKER_FORGE_CLIENT_ID }}
WOODPECKER_FORGEJO_SECRET={{ secrets.brokkr.WOODPECKER_FORGE_CLIENT_SECRET }}
WOODPECKER_AGENT_SECRET={{ secrets.brokkr.WOODPECKER_AGENT_SECRET }}

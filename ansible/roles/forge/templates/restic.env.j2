# This node's restic repository, separate from the cluster's. Written by ansible/roles/forge and
# read by both the backup and the prune unit, and by an operator running restic by hand.
#
# The key is scoped to this bucket alone (tofu/b2's b2_application_key.brokkr), so it cannot read
# the repository holding every cluster backup. That separation is the point — see
# docs/src/conventions/secrets.md.
RESTIC_REPOSITORY={{ forge_restic_repository }}
RESTIC_PASSWORD={{ secrets.brokkr.RESTIC_PASSWORD }}
AWS_ACCESS_KEY_ID={{ secrets.brokkr.B2_KEY_ID }}
AWS_SECRET_ACCESS_KEY={{ secrets.brokkr.B2_APPLICATION_KEY }}

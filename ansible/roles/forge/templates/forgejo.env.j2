# Forgejo's secrets. Written by ansible/roles/forge from config/sops/ops.sops.yaml's
# ansible.secrets.brokkr, resolved out of Proton Pass by `just ans render-secrets`. Never in git,
# never reconciled by the quadlet timer, which excludes *.env for exactly this reason.
#
# Everything that is not a secret is an Environment= line in the .container unit instead, so it is
# reviewable in a diff.
FORGEJO__security__SECRET_KEY={{ secrets.brokkr.FORGEJO_SECRET_KEY }}

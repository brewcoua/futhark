---
apiVersion: k0sctl.k0sproject.io/v1beta1
kind: Cluster
metadata:
  name: futhark
spec:
  hosts:
{% for host in groups['all'] %}
{% if hostvars[host].node.workflow == 'k0s' %}
    - role: {{ hostvars[host].node.k0s_role }}
      ssh:
        address: {{ hostvars[host].node.hostname + '.' + tailnet_domain if hostvars[host].node.mesh | default(false) else hostvars[host].node.ip }}
        user: {{ hostvars[host].admin.user }}
        port: {{ hostvars[host].ssh_port }}
{#      Mesh IP as InternalIP, not whatever interface k0s would otherwise pick — kubelet
        registers --node-ip as InternalIP only, it can't set ExternalIP at all (that's the
        k0s-cloud-provider annotation below instead). Interface-based, so it survives the
        mesh IP changing. #}
      privateInterface: tailscale0
      installFlags:
{% if hostvars[host].node.k0s_role == 'controller+worker' %}
        - --no-taints
        - --enable-k0s-cloud-provider=true
{% endif %}
        - --enable-cloud-provider=true
{% endif %}
{% endfor %}
{% set ns = namespace(controller=none) %}
{% for host in groups['all'] %}
{% if hostvars[host].node.workflow == 'k0s' and 'controller' in hostvars[host].node.k0s_role %}
{% set ns.controller = host %}
{% endif %}
{% endfor %}
{#  k0s otherwise self-detects spec.api.address from the default-route interface, which on
    these hosts is the public IP — join tokens then carry that address, and workers can't
    reach it (no route to host). Pin it to the controller's mesh address instead, resolved
    live via MagicDNS like ansible_host above, so nothing here goes stale. #}
  k0s:
    config:
      apiVersion: k0s.k0s.io/v1beta1
      kind: ClusterConfig
      spec:
        api:
          address: {{ lookup('community.general.dig', hostvars[ns.controller].node.hostname + '.' + tailnet_domain) }}
          sans:
            - {{ hostvars[ns.controller].node.hostname }}.{{ tailnet_domain }}
            - {{ hostvars[ns.controller].node.ip }}

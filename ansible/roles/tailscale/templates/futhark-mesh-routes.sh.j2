#!/bin/sh
# Generated by ansible/roles/tailscale — do not edit by hand.
#
# Makes pod-originated traffic to a Tailscale mesh peer's own address work. Two things are
# needed, and both are per-peer. See ansible/nodes/README.md for the full write-up.
#
# 1. Routing. kube-router sees that the nodes share no L2 segment and builds an IPIP overlay
#    between their mesh IPs. As part of that it installs `from <pod CIDR> lookup 77` at
#    pref 5209, and puts the peer's *mesh IP* into table 77 pointing at the tunnel — which
#    shadows Tailscale's own table 52 (pref 5270). The priority-100 rule below puts the peer's
#    mesh IP itself back on tailscale0, while leaving the peer's pod CIDR on the overlay.
#
# 2. SNAT. Routing alone is not enough: tailscaled drops packets whose source address is not
#    the node's own tailnet IP, as anti-spoofing. Pod-sourced packets (<pod CIDR>) therefore
#    die on egress even though the route is correct and FORWARD accepts them. Masquerading to
#    the node's tailnet IP is what actually makes the dial succeed. This is why cross-node
#    pod-to-pod already worked: IPIP wraps it in an outer header sourced from the node's own
#    mesh IP, so it never presents a foreign source to tailscaled.
#
#    Scoped to peer /32s, not the whole 100.64.0.0/10 tailnet, deliberately: pods get to reach
#    cluster nodes (konnectivity-agent -> konnectivity-server, Prometheus -> traefik on the
#    mesh IP) without inheriting the node's tag:futhark-node reach across the entire tailnet.
{% for host, ip in tailscale_peer_ips.items() %}

# {{ host }}
# `ip rule add` does *not* dedupe — identical rules stack, and this unit re-runs on every
# play — so delete first.
ip rule del to {{ ip }}/32 lookup 52 priority 100 2>/dev/null || true
ip rule add to {{ ip }}/32 lookup 52 priority 100

iptables -t nat -C POSTROUTING -s {{ k0s_pod_cidr }} -d {{ ip }}/32 -o tailscale0 -j MASQUERADE 2>/dev/null \
  || iptables -t nat -A POSTROUTING -s {{ k0s_pod_cidr }} -d {{ ip }}/32 -o tailscale0 -j MASQUERADE
{% endfor %}

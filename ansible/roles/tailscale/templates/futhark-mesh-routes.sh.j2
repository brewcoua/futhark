#!/bin/sh
# Generated by ansible/roles/tailscale — do not edit by hand.
#
# Forces traffic to each Tailscale mesh peer's own address through Tailscale's routing table
# (52), ahead of kube-router's pod-overlay table (77) which otherwise wins by rule priority.
# Idempotent: `ip rule add` of an identical rule is a harmless no-op.
{% for host, ip in tailscale_peer_ips.items() %}
ip rule add to {{ ip }}/32 lookup 52 priority 100 2>/dev/null || true
{% endfor %}

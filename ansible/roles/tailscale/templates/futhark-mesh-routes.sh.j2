#!/bin/sh
# Generated by ansible/roles/tailscale — do not edit by hand.
#
# Makes pod-originated traffic to a Tailscale mesh peer's own address work: one route fix and
# one SNAT rule per peer, both scoped to that peer's /32 so kube-router's pod-to-pod overlay is
# untouched. Why either is needed: docs/src/ansible/networking.md.
{% for host, ip in tailscale_peer_ips.items() %}

# {{ host }}
# `ip rule add` does *not* dedupe — identical rules stack, and this unit re-runs on every
# play — so drain every copy first. Draining without matching on priority also clears rules
# left at a priority this script used previously.
#
# The priority is load-bearing: kube-router installs its own `from <pod /24> lookup 77` rule,
# and anything numerically above it is silently shadowed, making this a no-op with no error.
# It's been 99, then 5209, and is priority 9 as of kube-router v2.10.0 (k0s v1.36.3) — check
# `ip rule` on the node after a kube-router bump rather than assuming a fixed gap holds.
while ip rule del to {{ ip }}/32 lookup 52 2>/dev/null; do :; done
ip rule add to {{ ip }}/32 lookup 52 priority 5

iptables -t nat -C POSTROUTING -s {{ k0s_pod_cidr }} -d {{ ip }}/32 -o tailscale0 -j MASQUERADE 2>/dev/null \
  || iptables -t nat -A POSTROUTING -s {{ k0s_pod_cidr }} -d {{ ip }}/32 -o tailscale0 -j MASQUERADE
{% endfor %}

---
# Template. At cold bootstrap, copy to secrets.sops.yml, fill in, and encrypt:
#
#   cp secrets.sops.yml.example secrets.sops.yml
#   $EDITOR secrets.sops.yml
#   sops -e -i secrets.sops.yml
#
# Identifying, not granting — none of these authorise anything on their own, they just tie the
# repo to a tailnet and a machine. Genuinely powerful values (the admin SSH *private* key, the
# Flux deploy key, the Infisical and Bitwarden credentials) are never committed in any form;
# they come from Bitwarden Secrets Manager at runtime. See docs/src/conventions/secrets.md.
admin:
  user: opsuser
  ssh_pubkey: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleExampleExampleExampleExampleExa"

# The tailnet's MagicDNS suffix, e.g. foo-bar.ts.net
tailnet_domain: example-tailnet.ts.net

# Bitwarden Secrets Manager secret IDs, resolved at runtime by bitwarden.secrets.lookup against
# BWS_ACCESS_TOKEN. The UUIDs are pointers, not values — but they identify a Bitwarden tenant,
# so they live in here with everything else identifying. `bws secret list` prints them.
bws_ids:
  git_deploy_key: 00000000-0000-0000-0000-000000000001
  age_cluster_key: 00000000-0000-0000-0000-000000000002
  infisical_client_id: 00000000-0000-0000-0000-000000000003
  infisical_client_secret: 00000000-0000-0000-0000-000000000004
  bitwarden_eso_token: 00000000-0000-0000-0000-000000000005
  tailscale_client_id: 00000000-0000-0000-0000-000000000006
  tailscale_client_secret: 00000000-0000-0000-0000-000000000007

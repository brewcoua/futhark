---
# Template. At cold bootstrap, copy to secrets.sops.yaml and encrypt — the values below are
# already correct unless the vault is named something other than `futharkd`:
#
#   just ops sops config/secrets.sops.yaml
#
# The crown jewels the *Ansible* plane needs, as `pass://<vault>/<item>/<field>` references
# rather than values. Nothing here grants anything on its own; resolving one needs a Proton Pass
# session on the operator machine. See docs/src/conventions/secrets.md.
#
# OpenTofu's credentials are deliberately absent — each module declares its own in its
# secrets.sops.env, where `pass-cli run` resolves them into the environment the providers read.
# Listing them here too would mean `pass-cli inject` writing secrets to
# ansible/.generated/secrets.yml that nothing on this plane ever reads.
#
# Encrypted anyway, to the operator GPG key ONLY — never the cluster age key. Vault, item and
# field names are identifying, and this file is a map to the keys that rebuild the cluster; the
# whole tier boundary is that the cluster cannot follow it. The `.sops.yaml` rule matching this
# path sits above the broader `(infra|nodes|config)/` one for exactly that reason.
#
# The admin SSH *private* key is deliberately not here and never will be. It is the operator's
# own identity, it lives in ~/.ssh on the machine doing the connecting, and Ansible authenticates
# with it rather than reading it. Its public half is `admin.ssh_pubkey` in
# ansible/inventory/group_vars/all/secrets.sops.yml — identifying, granting nothing.
#
# The `{{ }}` braces are pass-cli's, and load-bearing: `pass-cli inject` resolves only braced
# references. They are also Jinja syntax, which is why this file lives here and not under
# ansible/group_vars/ — see the rendering pipeline in .just/ansible.just.
secrets:
  # Read by ansible/roles/flux_bootstrap.
  flux:
    deploy_key: "{{ pass://futharkd/flux/deploy key }}"
  sops:
    age_key: "{{ pass://futharkd/sops/age key }}"

  # Read by ansible/roles/netbird, which mints single-use node setup keys with it. A separate
  # token from the policy PAT tofu/netbird uses, even though NetBird PATs cannot be scoped and
  # so both carry the same authority: either can be rotated or revoked without taking the other
  # plane down with it. Both are issued to a service user rather than to an operator's own
  # account, and both expire (365 days at most) — see docs/src/operations/checks.md.
  netbird:
    api_token: "{{ pass://futharkd/netbird-enrollment/token }}"

  # The read-only Infisical identity, seeded into each tier namespace by flux_bootstrap. The
  # `tofu-writer` half of the pair is deliberately not here: it can write /nodes/kenaz/actual,
  # never leaves the operator machine, and lives in tofu/oidc/secrets.sops.env instead.
  infisical:
    cluster_reader:
      client_id: "{{ pass://futharkd/infisical-cluster-reader/client id }}"
      client_secret: "{{ pass://futharkd/infisical-cluster-reader/client secret }}"
    # The backup tier's identity, seeded only into infisical-backup. Granted /infra/velero and
    # nothing else, and cluster_reader is denied that path — so the keys that encrypt every
    # backup are not readable with the credential every other namespace's operator holds.
    backup_reader:
      client_id: "{{ pass://futharkd/infisical-backup-reader/client id }}"
      client_secret: "{{ pass://futharkd/infisical-backup-reader/client secret }}"

---
# Template for the operator-only store: everything the Ansible, node and OpenTofu planes need,
# sealed to the operator GPG key and never to the cluster age key. Fill in, then encrypt with
# `just ops sops config/ops.sops.yaml`. What each key is, and why the values are references
# rather than secrets, is in docs/src/conventions/secrets.md.
ansible:
  admin:
    user: opsuser
    ssh_pubkey: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleExampleExampleExampleExampleExa"
  secrets:
    flux:
      deploy_key: "{{ pass://<vault>/flux/deploy key }}"
    sops:
      age_key: "{{ pass://<vault>/sops/age key }}"
    netbird:
      api_token: "{{ pass://<vault>/netbird-enrollment/token }}"
    healthchecks:
      kenaz: "{{ pass://<vault>/healthchecks/kenaz }}"
      ogma: "{{ pass://<vault>/healthchecks/ogma }}"
      brokkr: "{{ pass://<vault>/healthchecks/brokkr }}"
    # brokkr's runtime secrets. This node runs no Infisical operator and holds no store
    # credential of its own, so its secrets are pushed here by roles/podman_host into 0600 env
    # files rather than pulled at runtime. Config on brokkr reconciles from git; secrets do not.
    # See docs/src/conventions/secrets.md.
    brokkr:
      # The break-glass local account. The whole reason this node exists is that it keeps working
      # with the cluster — and therefore Pocket ID — down, so this is a password and not an
      # OIDC identity.
      FORGEJO_ADMIN_USER: forgeadmin
      FORGEJO_ADMIN_PASSWORD: "{{ pass://<vault>/brokkr-forgejo/admin password }}"
      FORGEJO_SECRET_KEY: "{{ pass://<vault>/brokkr-forgejo/secret key }}"
      # Minted by tofu/oidc and read out of its outputs, not written into Infisical: brokkr cannot
      # read Infisical. `just tf output oidc` prints both, then they are filed here by hand.
      FORGEJO_OIDC_CLIENT_ID: "{{ pass://<vault>/brokkr-forgejo/oidc client id }}"
      FORGEJO_OIDC_CLIENT_SECRET: "{{ pass://<vault>/brokkr-forgejo/oidc client secret }}"
      # Woodpecker authenticates against Forgejo, not against Pocket ID, so Forgejo mints this
      # pair. Created once in Forgejo's own OAuth application list at bootstrap.
      WOODPECKER_FORGE_CLIENT_ID: "{{ pass://<vault>/brokkr-woodpecker/forge client id }}"
      WOODPECKER_FORGE_CLIENT_SECRET: "{{ pass://<vault>/brokkr-woodpecker/forge client secret }}"
      WOODPECKER_AGENT_SECRET: "{{ pass://<vault>/brokkr-woodpecker/agent secret }}"
      # This node's own restic repository, separate from the cluster's. Held here as well as
      # nowhere else: there is no Infisical copy to lose access to.
      RESTIC_PASSWORD: "{{ pass://<vault>/brokkr-restic/repository password }}"
      # Minted by tofu/b2's b2_application_key.brokkr and filed here by hand, the same way k8up's
      # pair is filed into Infisical.
      B2_KEY_ID: "{{ pass://<vault>/brokkr-restic/key id }}"
      B2_APPLICATION_KEY: "{{ pass://<vault>/brokkr-restic/application key }}"
    infisical:
      cluster_reader:
        client_id: "{{ pass://<vault>/infisical-cluster-reader/client id }}"
        client_secret: "{{ pass://<vault>/infisical-cluster-reader/client secret }}"
      backup_reader:
        client_id: "{{ pass://<vault>/infisical-backup-reader/client id }}"
        client_secret: "{{ pass://<vault>/infisical-backup-reader/client secret }}"

nodes:
  kenaz:
    ip: 203.0.113.10
    mesh_ip: ""
  ogma:
    ip: 203.0.113.11
    mesh_ip: ""
  brokkr:
    ip: 203.0.113.12
    mesh_ip: ""

# brokkr's own restic bucket, top level rather than under `ansible` or `tofu` because both planes
# read it and neither reads the other's subtree: roles/forge needs it to build the repository URL,
# and tofu/b2 needs it to create the bucket. One copy, so the two cannot disagree — the same reason
# tofu/bunny reads the node addresses out of `nodes` rather than keeping its own.
#
# No region here. The region is a fact of the B2 account, not of the bucket, and it is already
# recorded once as B2_REGION in config/sops/cluster.sops.yaml.
brokkr:
  B2_BUCKET: example-brokkr

tofu:
  b2:
    B2_APPLICATION_KEY_ID: pass://<vault>/backblaze-tofu/key id
    B2_APPLICATION_KEY: pass://<vault>/backblaze-tofu/application key
    AWS_ACCESS_KEY_ID: pass://<vault>/backblaze-tofu-state/key id
    AWS_SECRET_ACCESS_KEY: pass://<vault>/backblaze-tofu-state/application key
    TF_VAR_state_passphrase: pass://<vault>/backblaze-tofu-state/state passphrase
    TF_BACKEND_BUCKET: example-tofu-state
  bunny:
    BUNNYNET_API_KEY: pass://<vault>/bunny/api key
  netbird:
    NB_PAT: pass://<vault>/netbird-policy/token
  oidc:
    POCKETID_BASE_URL: https://auth.example.eu
    POCKETID_API_TOKEN: pass://<vault>/pocketid/api token
    INFISICAL_UNIVERSAL_AUTH_CLIENT_ID: pass://<vault>/infisical-tofu-writer/client id
    INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET: pass://<vault>/infisical-tofu-writer/client secret
    TF_VAR_infisical_project_id: 00000000-0000-0000-0000-000000000000
  # The same tofu-writer identity and project as oidc. A second copy rather than a shared
  # anchor: each module's section is exported on its own, and sops has no way to reference one
  # section from another.
  bifrost:
    INFISICAL_UNIVERSAL_AUTH_CLIENT_ID: pass://<vault>/infisical-tofu-writer/client id
    INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET: pass://<vault>/infisical-tofu-writer/client secret
    TF_VAR_infisical_project_id: 00000000-0000-0000-0000-000000000000

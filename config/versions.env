# Pinned versions of every tool this repo installs, for operators and for CI alike. One place,
# so `just ops deps` and the GitHub workflows cannot drift apart — a local `just docs build`
# renders with the same mdbook CI publishes, and pre-commit runs the same kustomize.
#
# Dotenv rather than YAML, for the same reason config/domain/domain.env is: nothing here nests,
# and both consumers read this format natively — just via `set dotenv-path`, GitHub Actions via
# `cat >> $GITHUB_ENV`. Parsing YAML would mean a `yq` dependency in the very recipe whose job
# is to install dependencies.
#
# Bump deliberately. Every one of these used to be either duplicated across three files or,
# worse, a `latest`/`master` URL that changed under you between two runs of the same command.
#
# The `# renovate:` line above each pin is not decoration — it is the only thing that tells
# Renovate which upstream a bare shell variable belongs to. Move a pin without its comment and
# it silently stops being tracked. See docs/src/conventions/updates.md.
# renovate: datasource=github-releases depName=kubernetes-sigs/kustomize extractVersion=^kustomize/(?<version>.+)$
KUSTOMIZE_VERSION=v5.5.0
# renovate: datasource=github-releases depName=k0sproject/k0sctl
K0SCTL_VERSION=v0.20.0
# renovate: datasource=github-releases depName=rust-lang/mdBook
MDBOOK_VERSION=v0.5.4
# renovate: datasource=github-releases depName=getsops/sops
SOPS_VERSION=v3.13.3
# renovate: datasource=github-releases depName=protonpass/pass-cli
PASS_CLI_VERSION=2.2.4
# The tarball comes from get.helm.sh rather than a release asset, but the versions are helm's
# own GitHub releases — which is what Renovate watches.
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v3.21.3
# Also the `rev:` of the gitleaks hook in .pre-commit-config.yaml. Renovate groups the two so
# they move together; keep them equal by hand if you ever bump one directly.
# renovate: datasource=github-releases depName=gitleaks/gitleaks
GITLEAKS_VERSION=v8.30.1
# The CLI only. The server side is pinned by the chart in infra/backup/app/helmrelease.yaml;
# keep this on the matching appVersion so a restore is not driven by a mismatched client.
# renovate: datasource=github-releases depName=velero-io/velero
VELERO_VERSION=v1.18.2
# Operator machine only, and only at bootstrap: minting the Drive OAuth token and obscuring the
# crypt passwords for RCLONE_CONFIG. The cluster's rclone is the CSI driver's own image.
# renovate: datasource=github-releases depName=rclone/rclone
RCLONE_VERSION=v1.75.0
# renovate: datasource=github-releases depName=terrastruct/d2
D2_VERSION=v0.7.1
# renovate: datasource=github-releases depName=danieleades/mdbook-d2
MDBOOK_D2_VERSION=v0.3.8
# CI only. `just ops deps` cannot install the runner it is already running under, so operators
# get whatever Fedora ships; this pins the version the just-fmt pre-commit hook runs in CI.
# renovate: datasource=github-releases depName=casey/just
JUST_VERSION=1.57.0
